{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wh-program",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the API reaches the Worker; everything else is served straight from
    // the asset store, so page loads never spin up a script.
    "run_worker_first": ["/api/*"]
  },

  // ── The shared plan ───────────────────────────────────────────────────────
  //
  // Create the database once:
  //
  //     npx wrangler d1 create wh-program
  //
  // then uncomment the four lines below and paste in the `database_id` it
  // printed. See SETUP.md step 4.
  //
  // Until you do, the site deploys and loads perfectly well — it just has
  // nowhere to save, and says so.
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "wh-program",
  //     "database_id": "paste-the-id-here"
  //   }
  // ],

  "observability": { "enabled": true }
}
