{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wh-program",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the API reaches the Worker; everything else is served straight from
    // the asset store, so page loads never spin up a script.
    "run_worker_first": ["/api/*"]
  },

  // ── The shared plan ───────────────────────────────────────────────────────
  //
  // Every booking, session and catalogue edit lives here. The tables are in
  // schema.sql; `npm run db:schema` creates or updates them.
  //
  // Setting up a *separate* copy of this app (a staging site, say) means its
  // own database: `npx wrangler d1 create <name>`, then swap both values
  // below for the ones it prints. See SETUP.md step 4.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wh-program",
      "database_id": "256613f8-2dac-41cd-9eac-b9148d9720e2"
    }
  ],

  "observability": { "enabled": true }
}
