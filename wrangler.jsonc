{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wh-program",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the API reaches the Worker; everything else is served straight from
    // the asset store, so page loads never spin up a script.
    "run_worker_first": ["/api/*"]
  },

  // The shared plan. Create it once with `npx wrangler d1 create wh-program`
  // and paste the id it prints in below — see SETUP.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wh-program",
      "database_id": "PASTE_YOUR_DATABASE_ID_HERE"
    }
  ],

  "observability": { "enabled": true }
}
