{
  "name": "wh-program",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Itinerary builder for Woodhouse Adventure Park",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc -b",
    "db:schema": "wrangler d1 execute wh-program --remote --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute wh-program --local --file=./schema.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.0.0"
  }
}
